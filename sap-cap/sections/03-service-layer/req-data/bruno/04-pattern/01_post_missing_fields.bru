meta {
  name: POST missing both — 400 "name and country are required"
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/odata/v4/orders/BusinessPartners
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "city": "New York",
    "industry": "Tech"
  }
}

vars:pre-request {
  baseUrl: http://localhost:4004
}

docs {
  ## Slide 7 — Pattern (Step 1: Validate first)

  Handler at this point (the combined single-check version):

  ```js
  this.before('CREATE', 'BusinessPartners', req => {
    if (!req.data.name || !req.data.country)
      req.reject(400, 'name and country are required')
  })
  ```

  Both `name` and `country` are missing here. One combined check, one
  message — this is the pattern's first half, before normalise + inject
  get added in the next request.

  Expected: 400 Bad Request — "name and country are required".
}
